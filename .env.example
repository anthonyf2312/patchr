# Copy this file to .env and fill it in. Never commit .env.

# Required. Discord Developer Portal → your app → Bot → Reset Token.
DISCORD_TOKEN=

# Strongly recommended. A fine-grained token with "Public repositories (read-only)" access and
# nothing else: github.com/settings/personal-access-tokens/new. Without one, GitHub allows
# only 60 requests an hour.
GITHUB_TOKEN=

# Postgres. With Docker Compose this is set for you from POSTGRES_PASSWORD below.
# Leave DATABASE_URL empty to use the built-in database (PGlite), stored in PGLITE_DIR.
DATABASE_URL=
POSTGRES_PASSWORD=change-me
# PGLITE_DIR=./data/pglite

# Docker image to run. Until Patchr 1.0 is released only `edge` (the newest code) exists.
# After 1.0, delete this line to follow stable 1.x releases instead.
PATCHR_TAG=edge

# Development: register commands in one server only, where changes show up instantly.
# DEV_GUILD_ID=

# Optional.
# POLL_INTERVAL_SECONDS=180
# MAX_FEEDS_PER_GUILD=25
# HEALTH_PORT=3000
# LOG_LEVEL=info
# SUPPORT_URL=https://discord.gg/your-invite
# REPO_URL=https://github.com/anthonyf2312/patchr
# WEBSITE_URL=https://anthonyf2312.github.io/patchr
