{
  "name": "patchr",
  "version": "1.0.0",
  "description": "Patch notes, posted beautifully. A Discord bot that posts GitHub releases and custom patch notes.",
  "license": "MIT",
  "author": "Anthony (https://github.com/anthonyf2312)",
  "homepage": "https://anthonyf2312.github.io/patchr",
  "bugs": "https://github.com/anthonyf2312/patchr/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anthonyf2312/patchr.git"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "discord.js": "^14.27.0",
    "drizzle-orm": "^0.45.3",
    "node-emoji": "^2.2.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.13.6",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
